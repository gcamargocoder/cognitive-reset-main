# Copy this file to .env and fill in real values. Never commit .env.
#
# Client-side (safe to expose in the browser bundle — these are the
# public "anon"/"publishable" keys, not secrets).
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-only secret — bypasses Row Level Security. NEVER prefix this
# with VITE_ (that would ship it to the browser). Only read from
# src/integrations/supabase/client.server.ts and set it in your
# hosting provider's dashboard (Vercel/Lovable Cloud env vars), not here.
SUPABASE_SERVICE_ROLE_KEY=""
